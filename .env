# ============== Environment ==============
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ============== MongoDB ==============
MONGO_USER=argusadmin
MONGO_PASSWORD=arguspass123
DB_NAME=argus_core

# ============== Redis ==============
REDIS_PASSWORD=argusredis123

# ============== MinIO ==============
MINIO_ROOT_USER=argusadmin
MINIO_ROOT_PASSWORD=argusminio123

# ============== Security ==============
JWT_SECRET=2c5888e5f1917f4b5854659ac7e8d7249cf8d2c909e1df46fb027e24c5add60e25a189adf061faa6738901ccab27282b32b5dc40459cc685f958bcd17e43885d
API_KEY_SALT=argus-api-salt-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_RATE_LIMIT_PER_MINUTE=100

# ============== CORS ==============
CORS_ORIGINS=http://localhost:3000

# ============== GPU ==============
USE_GPU=false
GPU_PROFILE=cpu
GPU_MEMORY_LIMIT_MB=3500
GPU_COUNT=0
ENABLE_TENSORRT=false
FALLBACK_TO_CPU=true
BACKEND_BASE_IMAGE=python:3.11-slim

# ============== Execution ==============
EXECUTION_MODE=lite
ENABLE_MEMORY_GUARD=true

# ============== Celery ==============
CELERY_CONCURRENCY=1

# ============== Observability ==============
GRAFANA_ADMIN_PASSWORD=argusgrafana123

# ============== Models ==============
AUTO_DOWNLOAD_MODELS=true
DOWNLOAD_ON_STARTUP=false
VERIFY_MODEL_CHECKSUMS=false
ENABLE_SOTA_DETECTORS=false
HUGGINGFACE_TOKEN=

# ============== Feature Flags ==============
ENABLE_ADVERSARIAL_DEFENSES=false
ENABLE_RPS=false
ENABLE_ADVERSARIAL_GATE=false
ENABLE_RS_LITE=false
ENABLE_CALIBRATION=false
ENABLE_ATTN_LRP=false
ENABLE_EIGEN_CAM=false
ENABLE_AUDIO_BAND_ATTRIBUTION=false
ENABLE_TEMPORAL_ATTRIBUTION=false
ENABLE_DRIFT_DETECTION=false
ENABLE_TIMESFORMER=false
ENABLE_ECAPA=false
ENABLE_CONTINUOUS_LEARNING=false
ENABLE_XAI_ATTRIBUTION_OUTPUT=false
ENABLE_MODEL_WATERMARKING=false
ENABLE_CERTIFIED_ROBUSTNESS=false
ENABLE_CELERY_BEAT=false
ENABLE_PROMETHEUS_METRICS=true
ENABLE_MULTI_GPU=false
ARGUS_PREFER_MULTI_GPU=false
ENABLE_C2PA_V2=false

# ============== Frontend ==============
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
