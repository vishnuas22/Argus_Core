# ============================================================
# Argus Core - .env.example (Iteration 1)
# ============================================================
# Copy to .env and fill in real values. NEVER commit a real .env.
# All values marked with `:must be set` in docker-compose.yml MUST
# be provided here or the stack will refuse to start.
# ============================================================

# ===== Environment =====
ENVIRONMENT=production            # dev allows CORS=* and weaker JWT secret
LOG_LEVEL=INFO

# ===== MongoDB (auth mandatory) =====
MONGO_USER=argusadmin
MONGO_PASSWORD=change-me-to-a-long-random-string
MONGO_URL=mongodb://localhost:27017
DB_NAME=argus_core

# ===== Redis (password mandatory) =====
REDIS_PASSWORD=change-me-to-a-long-random-string
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===== MinIO =====
MINIO_ROOT_USER=argusadmin
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-string
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_UPLOADS=argus-uploads
MINIO_BUCKET_PREPROCESSED=argus-preprocessed
MINIO_BUCKET_RESULTS=argus-results

# ===== Security =====
# JWT_SECRET is read by config.py under both JWT_SECRET and SECRET_KEY.
# Use at least 32 random bytes (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-at-least-32-random-bytes
API_KEY_SALT=change-me-to-a-random-string
JWT_SECRET=2c5888e5f1917f4b5854659ac7e8d7249cf8d2c909e1df46fb027e24c5add60e25a189adf061faa6738901ccab27282b32b5dc40459cc685f958bcd17e43885d
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_RATE_LIMIT_PER_MINUTE=100

# ===== CORS (must be explicit in production) =====
# Comma-separated list of allowed origins. NEVER use "*" in production.
CORS_ORIGINS=http://localhost:3000

# ===== GPU =====
# Set to false for CPU-only deployments.
USE_GPU=true
GPU_PROFILE=t4                   # cpu | rtx3050 | t4 | a10 | a100
GPU_MEMORY_LIMIT_MB=14000
GPU_COUNT=1
ENABLE_TENSORRT=true
FALLBACK_TO_CPU=true
# For CPU-only builds, override the backend base image:
# BACKEND_BASE_IMAGE=python:3.11-slim

# ===== Iteration 8: Execution Mode =====
# Lite: CPU-only, quantized, minimal. Works on any laptop.
# Balanced: GPU if available, else CPU. Good balance.
# Research: GPU required, maximum accuracy, full defenses.
# Empty = auto-detect based on hardware.
EXECUTION_MODE=balanced
ENABLE_MEMORY_GUARD=true

# ===== Celery =====
CELERY_CONCURRENCY=2             # Lower if memory-constrained

# ===== Observability (Iteration 6) =====
GRAFANA_ADMIN_PASSWORD=change-me-to-a-strong-password

# ===== Models =====
AUTO_DOWNLOAD_MODELS=true
DOWNLOAD_ON_STARTUP=true
VERIFY_MODEL_CHECKSUMS=true
ENABLE_SOTA_DETECTORS=true
# Optional HF token for private / gated models (e.g. Llama-family):
HUGGINGFACE_TOKEN=

# ===== Iteration 3: Fine-tuned heads (optional, real benchmark numbers) =====
# Image: set to a verified public deepfake-specific model repo to get
# real benchmark numbers without training. Examples:
#   ARGUS_CLIP_FINE_TUNED_HEAD=dima806/deepfake_detection_model_image
#   ARGUS_SIGLIP_FINE_TUNED_HEAD=dima806/ai_vs_real_image_detection
ARGUS_CLIP_FINE_TUNED_HEAD=
ARGUS_SIGLIP_FINE_TUNED_HEAD=
# Audio: verified public deepfake-specific Wav2Vec2 models. Watch label
# polarity — some use {0:fake,1:real}, others {0:real,1:fake}. The
# detector auto-detects via id2label. Recommended:
#   ARGUS_WAV2VEC2_FINE_TUNED_HEAD=MelodyMachine/Deepfake-audio-detection-V2
ARGUS_WAV2VEC2_FINE_TUNED_HEAD=

# ===== Iteration 4: Diversity + Continuous Learning + XAI =====
# New detectors (diversity expansion)
ENABLE_TIMESFORMER=true       # TimeSformer video detector (cc-by-nc-4.0 — set false for commercial)
ENABLE_ECAPA=true             # ECAPA-TDNN audio detector (needs reference centroid)
# Continuous learning (online LoRA retraining)
ENABLE_CONTINUOUS_LEARNING=true
ENABLE_XAI_ATTRIBUTION_OUTPUT=true
RETRAIN_MIN_SAMPLES=50
RETRAIN_AB_TEST_RATIO=0.1

# ===== Iteration 5: Watermarking + Certified Robustness + Beat =====
# Model watermarking (IP protection for trained LoRA adapters)
ENABLE_MODEL_WATERMARKING=true
WATERMARK_KEY_LENGTH=256
# Certified robustness (OFF by default — n=10000 forward passes per input)
ENABLE_CERTIFIED_ROBUSTNESS=false
RS_CERTIFICATION_SIGMA=0.25
RS_CERTIFICATION_NUM_SAMPLES=10000
RS_CERTIFICATION_ALPHA=0.001
# Celery Beat (automatic retraining + drift + A/B evaluation)
ENABLE_CELERY_BEAT=true

# ===== Iteration 6: Observability + Multi-GPU + C2PA v2.3 =====
# Prometheus metrics (exposed at /metrics)
ENABLE_PROMETHEUS_METRICS=true
# Multi-GPU sharding (requires accelerate package)
ENABLE_MULTI_GPU=true
ARGUS_PREFER_MULTI_GPU=true
# C2PA v2.3 full compliance (requires c2pa-python + signing cert)
ENABLE_C2PA_V2=true
# C2PA signing cert (PEM) — get from a C2PA Trust List CA:
#   DigiCert, SSL.com, Tauth Labs, Trufo
C2PA_SIGN_CERT=/models/c2pa/sign_cert.pem
C2PA_PRIVATE_KEY=/models/c2pa/private_key.pem
# RFC 3161 Time-Stamping Authority URL (optional but recommended)
C2PA_TSA_URL=
C2PA_SIGNING_ALG=ES256

# ===== Iteration 2: Defenses / Calibration / XAI / Drift =====
# Adversarial defenses (training-free)
ENABLE_ADVERSARIAL_DEFENSES=true
ENABLE_RPS=true                # Randomized Preprocessing Sanitizer (~5% latency)
ENABLE_ADVERSARIAL_GATE=false  # XAI adversarial gate (~80ms overhead, OFF by default)
ENABLE_RS_LITE=false           # Randomized smoothing lite (~12% overhead, OFF by default)
# Calibration
ENABLE_CALIBRATION=true
CONFORMAL_ALPHA=0.10
# XAI upgrades
ENABLE_ATTN_LRP=true
ENABLE_EIGEN_CAM=true
ENABLE_AUDIO_BAND_ATTRIBUTION=true
ENABLE_TEMPORAL_ATTRIBUTION=true
# Drift detection
ENABLE_DRIFT_DETECTION=true
DRIFT_PSI_MODERATE=0.10
DRIFT_PSI_MAJOR=0.25
DRIFT_MMD_THRESHOLD=0.05

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
