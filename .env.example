# ============================================================
# Argus Core — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in REAL secrets.
# NEVER commit the real .env file.
#
# Generate strong secrets with:
#   openssl rand -hex 32
# ============================================================

# ============== ENVIRONMENT ==============
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============== DOMAIN (for CORS, TLS, redirects) ==============
ARGUS_DOMAIN=argus.example.com

# ============== SECRETS (generate with openssl rand -hex 32) ==============
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# ============== MONGODB ==============
MONGO_USER=argusadmin
MONGO_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
MONGO_URL=mongodb://argusadmin:CHANGE_ME@mongodb:27017/?authSource=admin
DB_NAME=argus_core

# ============== MINIO ==============
MINIO_ACCESS_KEY=argusadmin
MINIO_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# ============== CORS (must be explicit in production) ==============
CORS_ORIGINS=https://argus.example.com

# ============== GPU ==============
GPU_ENABLED=false
GPU_PROFILE=cpu
FALLBACK_TO_CPU=true
ENABLE_TENSORRT=false

# ============== EXECUTION ==============
EXECUTION_MODE=balanced
CELERY_CONCURRENCY=4

# ============== MODELS ==============
MODEL_CACHE_DIR=/models
HF_HOME=/models/hf_cache
ENABLE_SOTA_DETECTORS=true
VERIFY_MODEL_CHECKSUMS=true

# ============== CALIBRATION ==============
ENABLE_CALIBRATION=true

# ============== MONITORING ==============
ENABLE_PROMETHEUS_METRICS=true
SENTRY_DSN=

# ============== GRAFANA ==============
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# ============== VERSION (for image tagging) ==============
ARGUS_VERSION=latest

# ============== LOCAL STORAGE (fallback) ==============
LOCAL_STORAGE_DIR=./data/local_storage
